# Copy to hosts-internal.env (or hosts.env on YBA) for in-VPC JDBC + SSH.
# Includes JDBC host lists and SmartDriver topology-keys for the failover demo JAR.
#
# SSH_KEY="${SSH_KEY:-$HOME/.ssh/your_cluster_key}"
SSH_USER="${SSH_USER:-yugabyte}"

PRIMARY_NODES="192.0.2.10 192.0.2.11 192.0.2.12"
STANDBY_NODES="192.0.2.20 192.0.2.21 192.0.2.22"

PRIMARY_HOSTS="192.0.2.10:5433,192.0.2.11:5433,192.0.2.12:5433"
STANDBY_HOSTS="192.0.2.20:5433,192.0.2.21:5433,192.0.2.22:5433"

PRIMARY_TOPOLOGY_KEYS="cloud.region-a.*:1,cloud.region-b.*:1,cloud.region-c.*:1"
STANDBY_TOPOLOGY_KEYS="cloud.region-x.*:1,cloud.region-y.*:1,cloud.region-z.*:1"

SMART_DRIVER_LOAD_BALANCE=true

# Must match universe ids in your failover demo app (e.g. us/eu or primary/standby)
PRIMARY_UNIVERSE_ID="${PRIMARY_UNIVERSE_ID:-primary}"
STANDBY_UNIVERSE_ID="${STANDBY_UNIVERSE_ID:-standby}"
