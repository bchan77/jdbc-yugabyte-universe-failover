# Copy to hosts.env and edit for your cluster (public IPs or any SSH-reachable addresses).
#
# SSH_KEY="${SSH_KEY:-$HOME/.ssh/your_cluster_key}"
SSH_USER="${SSH_USER:-yugabyte}"

# Space-separated node IPs — one universe's tservers (primary / active in normal operation)
PRIMARY_NODES="203.0.113.10 203.0.113.11 203.0.113.12"

# Standby universe nodes
STANDBY_NODES="198.51.100.10 198.51.100.11 198.51.100.12"
